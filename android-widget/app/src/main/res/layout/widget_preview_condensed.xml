<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="0dp"
    android:background="#F7F9FC">

    <ProgressBar
        android:id="@+id/previewDayProgressTop"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="1000"
        android:progress="520"
        android:progressTint="#1677E8"
        android:progressBackgroundTint="#D8E0EA" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="2dp"
        android:paddingRight="3dp">
        <TextView android:layout_width="36dp" android:layout_height="match_parent" android:gravity="center" android:text="08:00" android:textColor="#5D6B82" android:textSize="7sp" android:textStyle="bold" />
        <TextView android:layout_width="3dp" android:layout_height="16dp" android:background="#F0335D" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:paddingLeft="4dp" android:ellipsize="end" android:maxLines="1" android:text="5G4 ALL · salle 217" android:textColor="#17213A" android:textSize="9sp" android:textStyle="bold" />
        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="6dp"
            android:max="1000"
            android:progress="580"
            android:progressTint="#1677E8"
            android:progressBackgroundTint="#D8E0EA" />
    </LinearLayout>

    <!-- TextView separators are supported by RemoteViews on Samsung launchers;
         a generic View here made the entire preview fall back to a white card. -->
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#D6DDE7" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="2dp"
        android:paddingRight="3dp"
        android:background="#E6F2FF">
        <TextView android:layout_width="36dp" android:layout_height="match_parent" android:gravity="center" android:text="10:00" android:textColor="#235F76" android:textSize="7sp" android:textStyle="bold" />
        <TextView android:layout_width="3dp" android:layout_height="14dp" android:background="#235F76" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#D5B84D" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="2dp"
        android:paddingRight="3dp"
        android:background="#FFE08A">
        <TextView android:layout_width="36dp" android:layout_height="match_parent" android:gravity="center" android:text="12:00" android:textColor="#59491D" android:textSize="7sp" android:textStyle="bold" />
        <TextView android:layout_width="3dp" android:layout_height="14dp" android:background="#59491D" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:paddingLeft="3dp" android:ellipsize="end" android:maxLines="1" android:text="Midi" android:textColor="#59491D" android:textSize="9sp" android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/previewDayProgressBottom"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="1000"
        android:progress="520"
        android:progressTint="#1677E8"
        android:progressBackgroundTint="#D8E0EA" />
</LinearLayout>
