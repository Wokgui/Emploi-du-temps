<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvKind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cours en cours"
            android:textColor="#0AA6A6"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRefresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="#0AA6A6"
            android:textSize="22sp"
            android:contentDescription="@string/refresh" />

        <TextView
            android:id="@+id/btnEdit"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="✎"
            android:textColor="#0AA6A6"
            android:textSize="20sp"
            android:contentDescription="Modifier l'emploi du temps" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#101936"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSubstatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#5A667A"
        android:textSize="12sp" />

    <Chronometer
        android:id="@+id/countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="#0AA6A6"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/classProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progressTint="#0AA6A6"
        android:progressBackgroundTint="#E5E7EB" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Ensuite"
        android:textColor="#126FE5"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/upcomingList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:divider="#E5EAF0"
        android:dividerHeight="1dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/emptyUpcoming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Aucun autre cours programmé"
        android:textColor="#647087"
        android:textSize="12sp" />
</LinearLayout>
