<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="9dp"
    android:paddingRight="12dp"
    android:paddingBottom="0dp"
    android:background="@drawable/widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvKind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Cours en cours"
            android:textColor="#0AA6A6"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRefresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="↻"
            android:textColor="#0AA6A6"
            android:textSize="20sp"
            android:contentDescription="@string/refresh" />

        <TextView
            android:id="@+id/btnEdit"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="✎"
            android:textColor="#0AA6A6"
            android:textSize="18sp"
            android:contentDescription="Modifier l'emploi du temps" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#101936"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSubstatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#5A667A"
        android:textSize="11sp" />

    <ProgressBar
        android:id="@+id/classProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp"
        android:max="100"
        android:progressTint="#1178E8"
        android:progressBackgroundTint="#E5E7EB" />

    <ListView
        android:id="@+id/upcomingList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingBottom="0dp"
        android:clipToPadding="false"
        android:divider="#E5EAF0"
        android:dividerHeight="1dp"
        android:scrollbars="vertical"
        android:fadingEdge="none" />

    <TextView
        android:id="@+id/emptyUpcoming"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:text="Aucun autre cours programmé"
        android:textColor="#647087"
        android:textSize="11sp" />
</LinearLayout>
