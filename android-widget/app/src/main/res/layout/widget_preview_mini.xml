<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F9FC">

    <ProgressBar
        android:id="@+id/previewDayProgressTop"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="1000"
        android:progress="520"
        android:progressTint="#1677E8"
        android:progressBackgroundTint="#D8E0EA" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="7dp"
        android:paddingRight="7dp"
        android:background="#EEF2F7">
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="Emploi du temps"
            android:textColor="#17213A"
            android:textSize="7sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="14/09 · A"
            android:textColor="#64748B"
            android:textSize="6sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="#F0335D" android:text="8h\n5G4\n217" android:textColor="#FFFFFF" android:textSize="7sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="#18B9BE" android:text="9h\n4G3\n217" android:textColor="#17213A" android:textSize="7sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="#FF7B2F" android:text="10h\n3G3\n216" android:textColor="#17213A" android:textSize="7sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="#F1D36B" android:text="12h\nMidi" android:textColor="#17213A" android:textSize="7sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:background="#7BC67B" android:text="14h\n5G2\n218" android:textColor="#17213A" android:textSize="7sp" android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/previewDayProgressBottom"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:max="1000"
        android:progress="520"
        android:progressTint="#1677E8"
        android:progressBackgroundTint="#D8E0EA" />
</LinearLayout>
