<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="1dp"
    android:paddingRight="1dp">

    <TextView
        android:id="@+id/rowIndex"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:gravity="center"
        android:background="@drawable/widget_index_badge"
        android:textColor="#56657A"
        android:textSize="8sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="16dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowLineTop"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#A7B5C7"
            android:text="" />

        <TextView
            android:id="@+id/rowDot"
            android:layout_width="16dp"
            android:layout_height="12dp"
            android:gravity="center"
            android:text="●"
            android:textColor="#74839A"
            android:textSize="8sp" />

        <TextView
            android:id="@+id/rowLineBottom"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#A7B5C7"
            android:text="" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingLeft="9dp"
        android:paddingTop="3dp"
        android:paddingRight="9dp"
        android:paddingBottom="3dp"
        android:background="@drawable/widget_course_row_background">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#17213A"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rowMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#66758A"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/rowRelative"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:maxLines="1"
                android:textColor="#5F6E84"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
