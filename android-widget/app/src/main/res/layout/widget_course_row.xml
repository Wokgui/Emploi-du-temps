<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="0dp">

    <TextView
        android:id="@+id/rowIndex"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:orientation="vertical">
        <TextView android:id="@+id/rowLineTop" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/rowDot" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        <TextView android:id="@+id/rowLineBottom" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    </LinearLayout>

    <!-- Format 1: widget actuel. Cette vue reste strictement identique visuellement. -->
    <LinearLayout
        android:id="@+id/rowContent"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingRight="0dp"
        android:background="#FFF0335D">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/rowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rowMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#F7FBFF"
                android:textSize="10sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="118dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="5dp">

            <TextView
                android:id="@+id/rowRelative"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:minWidth="60dp"
                android:maxWidth="118dp"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:background="@drawable/widget_timer_pill"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#A72B45"
                android:textSize="9sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <!-- Format 3: liste chronologique condensée. -->
    <LinearLayout
        android:id="@+id/rowCondensedContent"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="2dp"
        android:paddingRight="3dp"
        android:background="#00FFFFFF">

        <TextView
            android:id="@+id/rowCondensedTime"
            android:layout_width="36dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="#5D6B82"
            android:textSize="7sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="7dp"
            android:layout_height="match_parent">
            <TextView
                android:id="@+id/rowCondensedLineTop"
                android:layout_width="1dp"
                android:layout_height="11dp"
                android:layout_gravity="top|center_horizontal"
                android:background="#D6DDE7" />
            <TextView
                android:id="@+id/rowCondensedLineBottom"
                android:layout_width="1dp"
                android:layout_height="11dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="#D6DDE7" />
            <TextView
                android:id="@+id/rowCondensedAccent"
                android:layout_width="3dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:background="#1677E8" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingLeft="3dp">
            <TextView
                android:id="@+id/rowCondensedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#17213A"
                android:textSize="9sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/rowCondensedMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#64748B"
                android:textSize="9sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/rowCondensedCourseProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="6dp"
            android:visibility="gone"
            android:max="1000"
            android:progress="0"
            android:progressTint="#1677E8"
            android:progressBackgroundTint="#D8E0EA" />
    </LinearLayout>

    <!-- Format 4: mini planning horizontal. Une seule ligne est fournie par son service. -->
    <LinearLayout
        android:id="@+id/rowMiniContent"
        android:layout_width="match_parent"
        android:layout_height="105dp"
        android:visibility="gone"
        android:orientation="vertical"
        android:background="#F7F9FC">

        <LinearLayout
            android:id="@+id/rowMiniHeader"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:background="#EEF2F7">
            <TextView
                android:id="@+id/rowMiniTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Emploi du temps"
                android:textColor="#17213A"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/rowMiniDate"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:textColor="#64748B"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rowMiniTimeline"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <TextView android:id="@+id/miniCell1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="1dp" android:maxLines="3" android:ellipsize="end" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/miniCell2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="1dp" android:maxLines="3" android:ellipsize="end" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/miniCell3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="1dp" android:maxLines="3" android:ellipsize="end" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/miniCell4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="1dp" android:maxLines="3" android:ellipsize="end" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/miniCell5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="1dp" android:maxLines="3" android:ellipsize="end" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/miniCell6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="1dp" android:maxLines="3" android:ellipsize="end" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/miniCell7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="1dp" android:maxLines="3" android:ellipsize="end" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/miniCell8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="1dp" android:maxLines="3" android:ellipsize="end" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/miniCell9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="1dp" android:maxLines="3" android:ellipsize="end" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/miniCell10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="1dp" android:maxLines="3" android:ellipsize="end" android:textSize="7sp" android:textStyle="bold" />
            <TextView android:id="@+id/miniCell11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:padding="1dp" android:maxLines="3" android:ellipsize="end" android:textSize="7sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
