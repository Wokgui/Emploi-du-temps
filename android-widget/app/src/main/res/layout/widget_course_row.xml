<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="1dp"
    android:paddingRight="1dp">

    <TextView
        android:id="@+id/rowIndex"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:background="@drawable/widget_index_badge"
        android:textColor="#5B687C"
        android:textSize="9sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="16dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowLineTop"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#AAB7C8"
            android:text="" />

        <TextView
            android:id="@+id/rowDot"
            android:layout_width="16dp"
            android:layout_height="14dp"
            android:gravity="center"
            android:text="●"
            android:textColor="#73829A"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/rowLineBottom"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#AAB7C8"
            android:text="" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingLeft="10dp"
        android:paddingTop="4dp"
        android:paddingRight="10dp"
        android:paddingBottom="4dp"
        android:background="@drawable/widget_course_row_background">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#233049"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rowMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#6E7B90"
                android:textSize="8sp" />

            <TextView
                android:id="@+id/rowRelative"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:maxLines="1"
                android:textColor="#657289"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
